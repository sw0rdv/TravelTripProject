@using TravelTripProje.Models.Siniflar
@model List<Blog>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Bloglar</h2>

<table class="table table-bordered">
    <tr>
        <th>ID</th>
        <th>Başlık</th>
        <th>Sil</th>
        <th>Düzenle</th>
    </tr>

    @foreach (var x in Model)
    {
        <tr>
            <td>@x.ID</td>
            <td>@x.Baslik</td>

            <td>
                <a href="/Admin/BlogSil/@x.ID"
                   class="btn btn-danger">
                    Sil
                </a>
            </td>

            <td>
                <a href="/Admin/BlogGetir/@x.ID"
                   class="btn btn-warning">
                    Düzenle
                </a>
            </td>
        </tr>
    }
</table>

<a href="/Admin/YeniBlog/" class="btn btn-primary">
    Yeni Blog Ekle
</a>